        <div class="col">
            <h3>Mardi</h3>
            <p>17h45 - 19h15 : <span>Kids</span> 9-10 ans</p>
            <p class="txt-margin">Tarif : <span>340</span>€</p>
            <p>19h30 - 21h00 : <span>Adultes</span></p>
            <p class="txt-margin">Tarif : <span>390</span>€</p>
        </div>
        <div class="col">
            <h3>Mercredi</h3>
            <p>16h30 - 17h30 : <span>Minis</span> 4-6 ans</p>
            <p class="txt-margin">Tarif : <span>300</span>€</p>
            <p>17h30 - 18h30 : <span>Junior</span> 7-8 ans</p>
            <p class="txt-margin">Tarif : <span>300</span>€</p>
        </div>
        <div class="col">
            <h3>Samedi</h3>
            <p>10h00 - 11h30 : <span>Ados</span> débutant</p>
            <p>11h30 - 13h00 : <span>Ados</span> avancés</p>
            <p class="txt-margin">Tarif : <span>340</span>€</p>
            <p>14h00 - 16h00 : Stages <span>adultes/ados</span></p>
            <p class="txt-margin">Tarif : <span>50</span>€ par stage</p>
        </div>
    </div>
</div>